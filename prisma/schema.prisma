generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Module {
  POS
  STOCK
  EMPLOYEES
  PRODUCTS
  FINANCE
  HISTORY
  CUSTOMERS
  FIADOS
  MOTOBOYS
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum ProductType {
  STANDARD
  SUPPLY
  FRACTIONAL
  COMPOSITE
  COMBO
}

enum StockUnit {
  UNIT
  ML
  GRAM
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  LOSS
  OPEN_PACKAGING
  ADJUSTMENT
  REVERSAL
}

enum SaleStatus {
  PENDING_DELIVERY
  COMPLETED
  CANCELLED
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SUPPLY
  WITHDRAWAL
}

enum DeliveryStatus {
  PENDING
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum DeliveryPaymentType {
  PREPAID
  TO_COLLECT
}

enum DeliveryCancellationResolution {
  REFUND
  CUSTOMER_CREDIT
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  username        String?  @unique
  displayUsername String?
  role            UserRole @default(EMPLOYEE)

  sessions       Session[]
  accounts       Account[]
  accesses       UserModuleAccess[]
  stockMovements StockMovement[]
  sales          Sale[]
  cashMovements  CashMovement[]

  openedCashRegisters           CashRegister[] @relation("CashRegisterOpener")
  closedCashRegisters           CashRegister[] @relation("CashRegisterCloser")
  dispatchedDeliveries          Delivery[]     @relation("DeliveryDispatcher")
  returnedDeliveries            Delivery[]     @relation("DeliveryReturner")
  cancelledDeliveries           Delivery[]     @relation("DeliveryCanceller")
  resolvedDeliveryCancellations Delivery[]     @relation("DeliveryCancellationResolver")

  customerAccountMovements CustomerAccountMovement[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model UserModuleAccess {
  id     String @id @default(cuid())
  module Module

  canManageCashRegister Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  code        String      @unique
  barcode     String?     @unique
  name        String
  description String?
  type        ProductType @default(STANDARD)

  salePrice Decimal @db.Decimal(12, 2)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  stockItemId      String?
  stockItem        StockItem?      @relation(fields: [stockItemId], references: [id])
  stockPackagingId String?
  stockPackaging   StockPackaging? @relation(fields: [stockPackagingId], references: [id])

  packagingChildProductId String?   @unique
  packagingChildProduct   Product?  @relation("ProductPackagingChild", fields: [packagingChildProductId], references: [id], onDelete: Restrict)
  packagingParentProducts Product[] @relation("ProductPackagingChild")
  packagingChildQuantity  Decimal?  @db.Decimal(12, 3)

  composition      ProductComposition?
  comboItems       ComboItem[]         @relation("ComboProduct")
  includedInCombos ComboItem[]         @relation("ComponentProduct")
  saleItems        SaleItem[]

  @@index([name])
  @@index([categoryId])
  @@index([stockItemId])
  @@index([stockPackagingId])
  @@index([packagingChildProductId])
}

model StockItem {
  id           String    @id @default(cuid())
  name         String
  unit         StockUnit
  minStock     Decimal   @default(0) @db.Decimal(12, 3)
  purchaseCost Decimal   @default(0) @db.Decimal(12, 2)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  balance            StockBalance?
  packagings         StockPackaging[]
  products           Product[]
  compositionOptions CompositionOption[]
  movements          StockMovement[]

  @@index([name])
}

model StockBalance {
  id        String   @id @default(cuid())
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt

  stockItemId String    @unique
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
}

model StockPackaging {
  id               String   @id @default(cuid())
  name             String
  conversionFactor Decimal  @db.Decimal(12, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  balance   StockPackagingBalance?
  products  Product[]
  movements StockMovement[]

  @@unique([stockItemId, name])
}

model StockPackagingBalance {
  id        String   @id @default(cuid())
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt

  stockPackagingId String         @unique
  stockPackaging   StockPackaging @relation(fields: [stockPackagingId], references: [id], onDelete: Cascade)
}

model ProductComposition {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  groups CompositionGroup[]
}

model CompositionGroup {
  id            String @id @default(cuid())
  name          String
  minSelections Int    @default(1)
  maxSelections Int    @default(1)
  position      Int    @default(0)

  compositionId String
  composition   ProductComposition @relation(fields: [compositionId], references: [id], onDelete: Cascade)

  options CompositionOption[]

  @@index([compositionId])
}

model CompositionOption {
  id       String  @id @default(cuid())
  quantity Decimal @db.Decimal(12, 3)
  position Int     @default(0)

  groupId String
  group   CompositionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([groupId, stockItemId])
  @@index([stockItemId])
}

model ComboItem {
  id       String  @id @default(cuid())
  quantity Decimal @db.Decimal(12, 3)

  comboProductId String
  comboProduct   Product @relation("ComboProduct", fields: [comboProductId], references: [id], onDelete: Cascade)

  componentProductId String
  componentProduct   Product @relation("ComponentProduct", fields: [componentProductId], references: [id])

  @@unique([comboProductId, componentProductId])
}

model StockMovement {
  id        String            @id @default(cuid())
  type      StockMovementType
  quantity  Decimal           @db.Decimal(12, 3)
  unit      StockUnit
  reason    String?
  reference String?
  createdAt DateTime          @default(now())

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  stockPackagingId String?
  stockPackaging   StockPackaging? @relation(fields: [stockPackagingId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([stockItemId, createdAt])
  @@index([stockPackagingId, createdAt])
  @@index([createdAt])
  @@index([saleId])
}

model Sale {
  id          String        @id @default(cuid())
  status      SaleStatus    @default(COMPLETED)
  total       Decimal       @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime      @default(now())
  cancelledAt DateTime?
  payments    SalePayment[]
  delivery    Delivery?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  cashReceived Decimal @default(0) @db.Decimal(12, 2)
  changeAmount Decimal @default(0) @db.Decimal(12, 2)

  accountMovements CustomerAccountMovement[]

  // Snapshot do endereço e taxa utilizados nesta venda
  deliveryZipCode      String?
  deliveryStreet       String?
  deliveryNumber       String?
  deliveryComplement   String?
  deliveryNeighborhood String?
  deliveryCity         String?
  deliveryState        String?
  deliveryReference    String?
  deliveryFee          Decimal @default(0) @db.Decimal(12, 2)

  items     SaleItem[]
  movements StockMovement[]

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@index([cashRegisterId])
}

model SaleItem {
  id          String    @id @default(cuid())
  productName String
  productCode String
  unit        StockUnit
  quantity    Decimal   @db.Decimal(12, 3)
  unitPrice   Decimal   @db.Decimal(12, 2)
  total       Decimal   @db.Decimal(12, 2)

  compositionSelections SaleItemCompositionSelection[]

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model SaleItemCompositionSelection {
  id String @id @default(cuid())

  groupName     String
  optionName    String
  stockItemId   String
  stockItemName String

  quantity Decimal   @db.Decimal(12, 3)
  unit     StockUnit

  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@index([saleItemId])
  @@index([stockItemId])
}

model CashRegister {
  id     String             @id @default(cuid())
  status CashRegisterStatus @default(OPEN)

  // Valores do caixa
  openingAmount  Decimal  @db.Decimal(12, 2)
  expectedAmount Decimal? @db.Decimal(12, 2)
  countedAmount  Decimal? @db.Decimal(12, 2)
  difference     Decimal? @db.Decimal(12, 2)

  // Datas
  openedAt DateTime  @default(now())
  closedAt DateTime?

  // Funcionário que abriu o caixa compartilhado
  openedById String
  openedBy   User   @relation("CashRegisterOpener", fields: [openedById], references: [id])

  // Funcionário que fechou
  closedById String?
  closedBy   User?   @relation("CashRegisterCloser", fields: [closedById], references: [id])

  customerAccountMovements CustomerAccountMovement[]

  // Relações
  movements CashMovement[]
  sales     Sale[]

  @@index([status])
  @@index([openedById])
  @@index([openedAt])
}

model CashMovement {
  id          String           @id @default(cuid())
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  description String?
  createdAt   DateTime         @default(now())

  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([cashRegisterId, createdAt])
  @@index([userId, createdAt])
}

model SalePayment {
  id            String        @id @default(cuid())
  paymentMethod PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

enum CustomerAccountMovementType {
  DEBIT
  CREDIT
  REVERSAL
}

model Customer {
  id              String @id @default(cuid())
  name            String
  phone           String
  phoneNormalized String @unique

  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses        CustomerAddress[]
  sales            Sale[]
  accountMovements CustomerAccountMovement[]

  @@index([name])
}

model CustomerAddress {
  id           String  @id @default(cuid())
  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  reference    String?

  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  isDefault   Boolean @default(false)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model Motoboy {
  id              String     @id @default(cuid())
  name            String
  phone           String
  phoneNormalized String     @unique
  notes           String?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deliveries      Delivery[]

  @@index([name])
}

model CustomerAccountMovement {
  id          String                           @id @default(cuid())
  type        CustomerAccountMovementType
  amount      Decimal                          @db.Decimal(12, 2)
  description String?
  payments    CustomerAccountMovementPayment[]
  createdAt   DateTime                         @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  reversalOfId String?                  @unique
  reversalOf   CustomerAccountMovement? @relation("AccountMovementReversal", fields: [reversalOfId], references: [id])
  reversedBy   CustomerAccountMovement? @relation("AccountMovementReversal")

  allocationsAsCredit CustomerAccountAllocation[] @relation("AllocationCredit")
  allocationsAsDebit  CustomerAccountAllocation[] @relation("AllocationDebit")
  deliveryCreditForId String?                     @unique
  deliveryCreditFor   Delivery?                   @relation("DeliveryCancellationCredit", fields: [deliveryCreditForId], references: [id], onDelete: Restrict)

  cashReceived Decimal @default(0) @db.Decimal(12, 2)
  changeAmount Decimal @default(0) @db.Decimal(12, 2)

  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([userId, createdAt])
  @@index([saleId])
  @@index([cashRegisterId, createdAt])
}

model CustomerAccountAllocation {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  creditMovementId String
  creditMovement   CustomerAccountMovement @relation("AllocationCredit", fields: [creditMovementId], references: [id], onDelete: Restrict)

  debitMovementId String
  debitMovement   CustomerAccountMovement @relation("AllocationDebit", fields: [debitMovementId], references: [id], onDelete: Restrict)

  @@unique([creditMovementId, debitMovementId])
  @@index([debitMovementId])
}

model CustomerAccountMovementPayment {
  id        String        @id @default(cuid())
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now())

  movementId String
  movement   CustomerAccountMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([movementId])
}

model Delivery {
  id     String         @id @default(cuid())
  status DeliveryStatus @default(PENDING)

  // Taxa da entrega (espelha Sale.deliveryFee definida na venda)
  fee Decimal @default(0) @db.Decimal(12, 2)

  // Previsão de dinheiro entregue pelo cliente e troco
  predictedCashReceived Decimal @default(0) @db.Decimal(12, 2)
  predictedChangeAmount Decimal @default(0) @db.Decimal(12, 2)

  // Saída
  dispatchedAt   DateTime?
  dispatchedById String?
  dispatchedBy   User?     @relation("DeliveryDispatcher", fields: [dispatchedById], references: [id])

  // Retorno
  returnedAt   DateTime?
  returnedById String?
  returnedBy   User?     @relation("DeliveryReturner", fields: [returnedById], references: [id])

  // Cancelamento
  cancelledAt              DateTime?
  cancellationReason       String?
  cancellationResolution   DeliveryCancellationResolution?
  cancellationRefundAmount Decimal?                        @db.Decimal(12, 2)
  cancellationResolvedAt   DateTime?

  cancelledById String?
  cancelledBy   User?   @relation("DeliveryCanceller", fields: [cancelledById], references: [id])

  cancellationResolvedById String?
  cancellationResolvedBy   User?   @relation("DeliveryCancellationResolver", fields: [cancellationResolvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Uma única entrega por venda
  saleId String @unique
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  motoboyId String?
  motoboy   Motoboy? @relation(fields: [motoboyId], references: [id], onDelete: Restrict)

  payments DeliveryPayment[]

  // Crédito criado caso a entrega seja cancelada
  cancellationCreditMovement CustomerAccountMovement? @relation("DeliveryCancellationCredit")

  @@index([status, createdAt])
  @@index([motoboyId])
}

model DeliveryPayment {
  id String @id @default(cuid())

  type   DeliveryPaymentType
  method PaymentMethod
  amount Decimal             @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}
