
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Module {
  POS
  STOCK
  EMPLOYEES
  PRODUCTS
  FINANCE
  HISTORY
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum ProductType {
  STANDARD
  SUPPLY
  FRACTIONAL
  COMPOSITE
  COMBO
}

enum StockUnit {
  UNIT
  ML
  GRAM
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  LOSS
  OPEN_PACKAGING
  ADJUSTMENT
  REVERSAL
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  username        String?  @unique
  displayUsername String?
  role            UserRole @default(EMPLOYEE)

  sessions       Session[]
  accounts       Account[]
  accesses       UserModuleAccess[]
  stockMovements StockMovement[]
  sales          Sale[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model UserModuleAccess {
  id     String @id @default(cuid())
  module Module

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  code        String      @unique
  barcode     String?     @unique
  name        String
  description String?
  type        ProductType @default(STANDARD)

  salePrice Decimal @db.Decimal(12, 2)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  stockItemId      String?
  stockItem        StockItem?     @relation(fields: [stockItemId], references: [id])
  stockPackagingId String?
  stockPackaging   StockPackaging? @relation(fields: [stockPackagingId], references: [id])

  recipeItems      ProductRecipeItem[] @relation("RecipeProduct")
  comboItems       ComboItem[]         @relation("ComboProduct")
  includedInCombos ComboItem[]         @relation("ComponentProduct")
  saleItems        SaleItem[]

  @@index([name])
  @@index([categoryId])
  @@index([stockItemId])
  @@index([stockPackagingId])
}

model StockItem {
  id           String    @id @default(cuid())
  name         String
  unit         StockUnit
  minStock     Decimal   @default(0) @db.Decimal(12, 3)
  purchaseCost Decimal   @default(0) @db.Decimal(12, 2)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  balance    StockBalance?
  packagings StockPackaging[]
  products   Product[]
  recipeUses ProductRecipeItem[]
  movements  StockMovement[]

  @@index([name])
}

model StockBalance {
  id        String   @id @default(cuid())
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt

  stockItemId String    @unique
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
}

model StockPackaging {
  id               String   @id @default(cuid())
  name             String
  conversionFactor Decimal  @db.Decimal(12, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  balance   StockPackagingBalance?
  products  Product[]
  movements StockMovement[]

  @@unique([stockItemId, name])
}

model StockPackagingBalance {
  id        String   @id @default(cuid())
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt

  stockPackagingId String         @unique
  stockPackaging   StockPackaging @relation(fields: [stockPackagingId], references: [id], onDelete: Cascade)
}

model ProductRecipeItem {
  id       String  @id @default(cuid())
  quantity Decimal @db.Decimal(12, 3)

  productId String
  product   Product @relation("RecipeProduct", fields: [productId], references: [id], onDelete: Cascade)

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([productId, stockItemId])
}

model ComboItem {
  id       String  @id @default(cuid())
  quantity Decimal @db.Decimal(12, 3)

  comboProductId String
  comboProduct   Product @relation("ComboProduct", fields: [comboProductId], references: [id], onDelete: Cascade)

  componentProductId String
  componentProduct   Product @relation("ComponentProduct", fields: [componentProductId], references: [id])

  @@unique([comboProductId, componentProductId])
}

model StockMovement {
  id        String            @id @default(cuid())
  type      StockMovementType
  quantity  Decimal           @db.Decimal(12, 3)
  unit      StockUnit
  reason    String?
  reference String?
  createdAt DateTime          @default(now())

  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])

  stockPackagingId String?
  stockPackaging   StockPackaging? @relation(fields: [stockPackagingId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([stockItemId, createdAt])
  @@index([stockPackagingId, createdAt])
  @@index([createdAt])
  @@index([saleId])
}

model Sale {
  id            String         @id @default(cuid())
  status        SaleStatus     @default(COMPLETED)
  paymentMethod PaymentMethod?
  total         Decimal        @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime       @default(now())
  cancelledAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  items     SaleItem[]
  movements StockMovement[]

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@index([paymentMethod])
}

model SaleItem {
  id          String    @id @default(cuid())
  productName String
  productCode String
  unit        StockUnit
  quantity    Decimal   @db.Decimal(12, 3)
  unitPrice   Decimal   @db.Decimal(12, 2)
  total       Decimal   @db.Decimal(12, 2)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}
